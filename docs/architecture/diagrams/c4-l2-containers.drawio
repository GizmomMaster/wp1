        <mxCell id="bffClient" value="&lt;b&gt;bff-client&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;агрегация API, сессии, CSRF&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="190" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="bffAdmin" value="&lt;b&gt;bff-admin&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;агрегация API, rate limit&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="190" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="edgeNote" value="Два BFF — две сетевые зоны и две модели доступа: клиент видит только свои организации, администратор — весь периметр. Логин через Keycloak по OIDC; бесшовный переход из ДБО ЮРЛ сверяется по ФИО + ИНН физлица + ИНН компании." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="520" y="115" width="245" height="125" as="geometry" />
        </mxCell>

        <mxCell id="bandCore" value="БИЗНЕС-СЕРВИСЫ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#666666;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="740" height="320" as="geometry" />
        </mxCell>
        <mxCell id="iam" value="&lt;b&gt;iam-svc&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;пользователи, роли, права, привязка к организациям, SSO-переход, профиль&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
