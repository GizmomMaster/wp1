        </mxCell>
        <mxCell id="slip" value="&lt;b&gt;payslip-svc&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;расчётные листы, генерация HTML, архивация, публичный API для ЛК&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="505" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf" value="&lt;b&gt;workflow-svc&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;конфигурируемые статусные модели, маршруты согласования, задачи и возврат на доработку&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="505" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="coreNote" value="Правила: база на сервис, кросс-БД запросы запрещены правами; у каждой сущности ровно один сервис-мастер, остальные держат проекции и обновляют их по событиям Kafka." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="540" y="505" width="225" height="80" as="geometry" />
        </mxCell>

