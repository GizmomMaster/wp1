        <mxCell id="pay" value="&lt;b&gt;payment-svc&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;платёжные поручения, кешбэк, разовые выплаты · Idempotency-Key&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
