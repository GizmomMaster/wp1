        <mxCell id="bandIntegr" value="ИНТЕГРАЦИЯ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#666666;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="290" width="260" height="580" as="geometry" />
        </mxCell>
        <mxCell id="hub" value="&lt;b&gt;integration-hub&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Единственная точка выхода наружу.&lt;br&gt;&lt;br&gt;Адаптеры: WAY4 · EQ · CRM · Factory · Карт Перс · ДБО ЮРЛ&lt;br&gt;&lt;br&gt;retry с backoff · circuit breaker на адаптер · журнал вызовов · идемпотентность команд&lt;br&gt;&lt;br&gt;Смена протокола внешней системы меняет один адаптер, а не бизнес-сервисы.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="325" width="220" height="290" as="geometry" />
        </mxCell>
        <mxCell id="mail" value="&lt;b&gt;mail-worker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;IMAP-ящик: письма от ДБО ЮРЛ с файлом по картам и суммой для зачисления&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="660" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="bandExt" value="ВНЕШНИЕ СИСТЕМЫ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#666666;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="1120" y="290" width="230" height="580" as="geometry" />
        </mxCell>
        <mxCell id="ext" value="&lt;b&gt;WAY4&lt;/b&gt; — переводы&lt;br&gt;&lt;b&gt;EQ&lt;/b&gt; — счета юрлиц&lt;br&gt;&lt;b&gt;CRM&lt;/b&gt; — мастер-данные физлиц&lt;br&gt;&lt;b&gt;Factory&lt;/b&gt; — заказ выпуска карт&lt;br&gt;&lt;b&gt;Карт Перс&lt;/b&gt; — пластик&lt;br&gt;&lt;b&gt;ДБО ЮРЛ&lt;/b&gt; — поручения, SSO&lt;br&gt;&lt;b&gt;SMTP / IMAP&lt;/b&gt; — почта&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Каждый вызов — с ключом идемпотентности и записью в журнал интеграций.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1140" y="325" width="190" height="290" as="geometry" />
        </mxCell>

