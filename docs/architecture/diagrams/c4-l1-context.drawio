        <mxCell id="lblExt" value="ВНЕШНИЕ СИСТЕМЫ БАНКА" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#666666;letterSpacing=1;" vertex="1" parent="1">
