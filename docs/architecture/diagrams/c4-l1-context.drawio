        <mxCell id="actAdmin" value="&lt;b&gt;Администратор ОРИОН&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;[Актор · административный контур]&lt;/font&gt;&lt;br&gt;Согласование заявок, организации, договоры, казначейство" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
