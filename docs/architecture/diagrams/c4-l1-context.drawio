        <mxCell id="actBank" value="&lt;b&gt;Расчётчик банка&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;[Актор · внутрибанковский контур]&lt;/font&gt;&lt;br&gt;Загрузка данных для расчётных листов" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
