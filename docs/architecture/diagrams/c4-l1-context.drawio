        <mxCell id="orion" value="&lt;b&gt;ОРИОН&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;[Система · React + .NET 10]&lt;/font&gt;&lt;br&gt;Зарплатный проект: выпуск карт, выплаты, казначейство, расчётные листы" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=14;" vertex="1" parent="1">
